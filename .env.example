# ==============================================================================
# GetHired - Environment Configuration
# ==============================================================================

# AI Provider Configuration
# Options for LLM_PROVIDER: "openai" | "claude" | "gemini" | "grok"
LLM_PROVIDER=openai

# Model Selection
# OpenAI: gpt-4o-mini | gpt-4o | o3-mini | gpt-4.5-preview
# Claude: claude-3-5-sonnet-20241022 | claude-3-5-haiku-20241022 | claude-3-opus-20240229
# Gemini: gemini-2.0-flash | gemini-1.5-pro | gemini-1.5-flash
# Grok:   grok-2-latest | grok-2-1212 | grok-beta
LLM_MODEL=gpt-4o-mini

# API Keys (Set the key for your selected provider, or configure directly in the Web UI)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
GROK_API_KEY=xai-...

# Outbound Email (SMTP)
# For Gmail, use a 16-character App Password (not your primary password)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourname@gmail.com
SMTP_PASS=your_16_character_app_password
EMAIL_FROM_NAME=Jane Doe

# Paths
CANDIDATE_PROFILE_PATH=./candidate_profile.json
PREFERENCES_PATH=./preferences.json
CV_ATTACHMENT_PATH=./assets/cv.pdf
SQLITE_DB_PATH=./jobs.db
